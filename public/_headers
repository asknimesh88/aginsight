# Cloudflare Pages response headers

# Keep the temporary *.pages.dev address out of Google so it never competes with the real domain
https://:project.pages.dev/*
  X-Robots-Tag: noindex

# Next.js build assets have content hashes in their names, so they can be cached forever
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
