# AgInsight static site on Apache (university server).
# Mirrors public/_redirects and public/_headers, which Cloudflare uses.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Never serve hidden files or folders (.ssh, .git, mail queue); keep .well-known for certificates
RedirectMatch 404 "/\.(?!well-known/)"

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Once HTTPS is enabled on the server, uncomment these two lines to force it
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Old WordPress front-page URLs -> homepage
  RewriteRule ^home-(2024|1)/?$ / [R=301,L]

  # 2024 abstract template and author declaration -> 2027 versions
  RewriteRule ^wp\-content/uploads/2019/05/Abstract\-Guidelines\-Aginsight\-2024\-No\-Author\-Information\.docx$ /wp-content/uploads/2026/10/Abstract-Guidelines-Aginsight-2027-No-Author-Information.docx [R=301,L]
  RewriteRule ^wp\-content/uploads/2019/05/Author\-Declaration\-AgInsight\-2024\.pdf$ /wp-content/uploads/2026/10/Author-Declaration-AgInsight-2027.pdf [R=301,L]

  # Old WordPress "/index.php/page-name/" permalinks -> clean URLs
  RewriteRule ^index\.php/(.+)$ /$1 [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Pages: always revalidate so updates show immediately
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  # Images and documents: cache for 30 days
  <FilesMatch "\.(jpe?g|png|webp|svg|ico|pdf|docx)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # Next.js build assets have content hashes in their names: cache forever
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>
